HEDERA_NETWORK=testnet
# Server-only HMAC secret for Hedera-wallet administrator sessions.
# Generate with: openssl rand -base64 32
YAREON_AUTH_SECRET=
# Server-only. Never prefix these fields with NEXT_PUBLIC_.
HEDERA_OPERATOR_ID=
HEDERA_OPERATOR_KEY=
# Shared append-only event ledger. Individual program treasuries and approval
# accounts are provisioned by each creator through the application.
HEDERA_TOPIC_ID=
HEDERA_MIRROR_NODE_URL=https://testnet.mirrornode.hedera.com
# Browser-safe WalletConnect project used for native Hedera schedule signing.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
# World AgentKit verifier. Only the public agent address belongs on the server.
# Keep WORLD_AGENT_PRIVATE_KEY exclusively in the agent CLI environment.
WORLD_AGENT_ADDRESS=
# AgentBook registry lookup. For the staging simulator flow, use the Base
# Sepolia deployment shown below. Production defaults to canonical World Chain
# when these are unset.
AGENTBOOK_RPC_URL=
AGENTBOOK_CONTRACT_ADDRESS=
AGENTBOOK_NETWORK=
WORLD_CHAIN_RPC_URL=
YAREON_PUBLIC_URL=http://127.0.0.1:3000
