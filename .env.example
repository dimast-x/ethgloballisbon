HEDERA_NETWORK=testnet
# Server-only HMAC secret for Hedera-wallet administrator sessions.
# Generate with: openssl rand -base64 32
YAREON_AUTH_SECRET=
# Server-only. Never prefix these fields with NEXT_PUBLIC_.
HEDERA_OPERATOR_ID=
HEDERA_OPERATOR_KEY=
# Shared append-only event ledger. Individual program treasuries and approval
# accounts are provisioned by each creator through the application.
HEDERA_TOPIC_ID=
HEDERA_MIRROR_NODE_URL=https://testnet.mirrornode.hedera.com
# Existing curated testnet program rendered by the public read-only showcase.
YAREON_SHOWCASE_PROGRAM_ID=
# Browser-safe WalletConnect project used for native Hedera schedule signing.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
# Public identity resolution. The RPC URL may contain a provider token, so it
# remains server-only.
ENS_RPC_URL=
YAREON_AGENT_ENS_NAME=buyer.robotics-lab.eth
YAREON_ORGANIZATION_ENS_NAME=lisbon-university.eth
# World ID v4. WORLD_RP_SIGNING_KEY is server-only and must never be prefixed
# with NEXT_PUBLIC_.
WORLD_APP_ID=
WORLD_RP_ID=
WORLD_RP_SIGNING_KEY=
WORLD_ACTION=authorize-yareon-agent
WORLD_ENVIRONMENT=production
NEXT_PUBLIC_WORLD_APP_ID=
NEXT_PUBLIC_WORLD_ENVIRONMENT=production
