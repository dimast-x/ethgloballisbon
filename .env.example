HEDERA_NETWORK=testnet
# Server-only. Never prefix these fields with NEXT_PUBLIC_.
HEDERA_OPERATOR_ID=
HEDERA_OPERATOR_KEY=
HEDERA_TOPIC_ID=
HEDERA_TREASURY_ACCOUNT_ID=
HEDERA_VENDOR_ACCOUNT_ID=
HEDERA_VERIFIER_RELAY_KEY=
HEDERA_FINANCE_RELAY_KEY=
HEDERA_MIRROR_NODE_URL=https://testnet.mirrornode.hedera.com
# Browser-safe MetaMask role allowlist for live testnet mode.
NEXT_PUBLIC_METAMASK_VERIFIER_ADDRESS=
NEXT_PUBLIC_METAMASK_FINANCE_ADDRESS=
# Public identity resolution. The RPC URL may contain a provider token, so it
# remains server-only.
ENS_RPC_URL=
OPENPROCURE_AGENT_ENS_NAME=buyer.robotics-lab.eth
OPENPROCURE_ORGANIZATION_ENS_NAME=lisbon-university.eth
# World ID v4. WORLD_RP_SIGNING_KEY is server-only and must never be prefixed
# with NEXT_PUBLIC_.
WORLD_APP_ID=
WORLD_RP_ID=
WORLD_RP_SIGNING_KEY=
WORLD_ACTION=authorize-openprocure-agent
WORLD_ENVIRONMENT=production
NEXT_PUBLIC_WORLD_APP_ID=
NEXT_PUBLIC_WORLD_ENVIRONMENT=production
