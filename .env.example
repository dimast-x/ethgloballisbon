HEDERA_NETWORK=testnet
# Server-only. Never prefix these fields with NEXT_PUBLIC_.
HEDERA_OPERATOR_ID=
HEDERA_OPERATOR_KEY=
HEDERA_TOPIC_ID=
HEDERA_TREASURY_ACCOUNT_ID=
HEDERA_VENDOR_ACCOUNT_ID=
HEDERA_VERIFIER_ACCOUNT_ID=
HEDERA_FINANCE_ACCOUNT_ID=
HEDERA_MIRROR_NODE_URL=https://testnet.mirrornode.hedera.com
# Comma-separated ChatGPT-authenticated team members allowed to mutate live
# testnet state. Public visitors can inspect only the verified live showcase.
CHARTER_ADMIN_EMAILS=
# Existing curated testnet program rendered by the public read-only showcase.
CHARTER_SHOWCASE_PROGRAM_ID=
# Browser-safe WalletConnect project used for native Hedera schedule signing.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
# Public identity resolution. The RPC URL may contain a provider token, so it
# remains server-only.
ENS_RPC_URL=
CHARTER_AGENT_ENS_NAME=buyer.robotics-lab.eth
CHARTER_ORGANIZATION_ENS_NAME=lisbon-university.eth
# World ID v4. WORLD_RP_SIGNING_KEY is server-only and must never be prefixed
# with NEXT_PUBLIC_.
WORLD_APP_ID=
WORLD_RP_ID=
WORLD_RP_SIGNING_KEY=
WORLD_ACTION=authorize-charter-agent
WORLD_ENVIRONMENT=production
NEXT_PUBLIC_WORLD_APP_ID=
NEXT_PUBLIC_WORLD_ENVIRONMENT=production
