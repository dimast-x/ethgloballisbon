{
  "name": "openprocure",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "build": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "test": "vitest run --config vitest.config.ts",
    "test:testnet": "RUN_HEDERA_TESTNET=1 vitest run --config vitest.config.ts test/hedera.testnet.spec.ts",
    "test:site": "npm run build && node --test tests/rendered-html.test.mjs",
    "typecheck": "tsc --noEmit",
    "demo:cli": "tsx scripts/demo-cli.ts",
    "demo:live": "tsx scripts/demo-cli.ts run testnet",
    "testnet:validate": "tsx scripts/demo-cli.ts validate",
    "audit:cli": "tsx scripts/demo-cli.ts audit",
    "setup:testnet": "tsx scripts/setup-testnet.ts",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next"
  },
  "dependencies": {
    "@hashgraph/hedera-wallet-connect": "^2.1.3",
    "@hashgraph/sdk": "^2.81.0",
    "@hiero-ledger/proto": "^2.31.0",
    "@hiero-ledger/sdk": "^2.79.0",
    "@walletconnect/modal": "^2.7.0",
    "lucide-react": "^0.468.0",
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "^4.20260702.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "tsx": "^4.20.6",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "vitest": "^3.2.4",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
