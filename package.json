{
  "name": "yareon",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "build:cli": "npm run build --workspace @yareon/cli",
    "test": "vitest run --config vitest.config.ts",
    "test:testnet": "RUN_HEDERA_TESTNET=1 vitest run --config vitest.config.ts test/hedera.testnet.spec.ts",
    "test:site": "npm run build && node --test tests/rendered-html.test.mjs",
    "typecheck": "tsc --noEmit",
    "demo:cli": "tsx scripts/demo-cli.ts",
    "testnet:validate": "tsx scripts/demo-cli.ts validate",
    "verify:live": "tsx scripts/verify-live-run.ts",
    "audit:cli": "tsx scripts/demo-cli.ts audit",
    "identity:validate": "tsx scripts/demo-cli.ts identity:validate",
    "identity:resolve": "tsx scripts/demo-cli.ts identity:resolve",
    "agentkit:address": "tsx scripts/agentkit-cli.ts address",
    "agentkit:validate": "tsx scripts/agentkit-cli.ts validate",
    "demo:agentkit": "tsx scripts/agentkit-cli.ts demo",
    "setup:testnet": "tsx scripts/setup-platform-testnet.ts",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next --ignore-pattern packages/cli/dist"
  },
  "dependencies": {
    "@hashgraph/hedera-wallet-connect": "^2.1.3",
    "@hashgraph/sdk": "^2.81.0",
    "@hiero-ledger/proto": "^2.31.0",
    "@hiero-ledger/sdk": "^2.79.0",
    "@walletconnect/modal": "^2.7.0",
    "@worldcoin/agentkit": "0.2.0",
    "lucide-react": "^0.468.0",
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "viem": "^2.55.8",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "tailwindcss": "4.2.1",
    "tsx": "^4.20.6",
    "typescript": "5.9.3",
    "vitest": "^3.2.4"
  },
  "type": "module"
}
