{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yareon.com/schema/protocol-event-0.2.json",
  "title": "Yareon Protocol Event",
  "type": "object",
  "required": [
    "schemaVersion",
    "eventId",
    "eventType",
    "runId",
    "organizationId",
    "programId",
    "actor",
    "correlationId",
    "occurredAt",
    "data"
  ],
  "properties": {
    "schemaVersion": { "enum": ["0.1", "0.2"] },
    "eventId": { "type": "string", "minLength": 1 },
    "eventType": {
      "enum": [
        "PROGRAM_CREATED",
        "PROGRAM_SETTLEMENT_CONFIGURED",
        "PROGRAM_UPFUNDED",
        "BUYER_ALLOCATED",
        "BUYER_ALLOCATION_UPFUNDED",
        "VENDOR_APPROVED",
        "OFFER_REGISTERED",
        "SUPPLIER_UPDATED",
        "SUPPLIER_REMOVED",
        "ORDER_REJECTED_BY_POLICY",
        "ORDER_CREATED",
        "ORDER_ACCEPTED_BY_VENDOR",
        "PAYMENT_SCHEDULE_CREATED",
        "DELIVERY_SUBMITTED",
        "DELIVERY_APPROVED",
        "PAYMENT_SIGNATURE_ADDED",
        "PAYMENT_EXECUTED",
        "AGENT_IDENTITY_RESOLVED",
        "AGENT_HUMAN_BACKING_VERIFIED",
        "AGENTKIT_ACCESS_VERIFIED",
        "AGENT_DELEGATION_GRANTED",
        "AGENT_DELEGATION_UPFUNDED",
        "AGENT_AUTHORIZATION_EVALUATED"
      ]
    },
    "runId": { "type": "string" },
    "organizationId": { "type": "string" },
    "programId": { "type": "string" },
    "orderId": { "type": "string" },
    "actor": {
      "type": "object",
      "required": ["actorId", "role", "actorType"],
      "properties": {
        "actorId": { "type": "string" },
        "role": { "type": "string" },
        "actorType": { "enum": ["HUMAN", "AGENT", "SYSTEM"] },
        "hederaAccountId": { "type": "string" }
      },
      "additionalProperties": false
    },
    "correlationId": { "type": "string" },
    "occurredAt": { "type": "string", "format": "date-time" },
    "data": {}
  },
  "additionalProperties": false
}
